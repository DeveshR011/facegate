# FaceGate recognition API - NVIDIA GPU image (CUDA 12 + cuDNN 9 from pip wheels).
#
#   docker build -f Dockerfile.gpu -t facegate:gpu .
#   docker run --rm --gpus all -p 127.0.0.1:8000:8000 -v facegate-data:/data facegate:gpu
#
# Needs the NVIDIA Container Toolkit on the host (Docker Desktop + WSL 2 has it
# built in). Falls back to CPU automatically if no GPU is visible.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    FACEGATE_HOME=/data \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /app

COPY requirements-server.txt .
# Same stack as the CPU image, with onnxruntime swapped for the CUDA build.
# The [cuda,cudnn] extras pull the matching NVIDIA runtime libraries.
RUN sed -i '/^onnxruntime/d' requirements-server.txt \
    && pip install -r requirements-server.txt "onnxruntime-gpu[cuda,cudnn]>=1.21"

COPY facegate ./facegate

RUN useradd --create-home --uid 10001 facegate \
    && mkdir /data && chown facegate:facegate /data
USER facegate
VOLUME /data
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=8).status == 200 else 1)"

CMD ["python", "-m", "facegate", "serve", "--host", "0.0.0.0", "--port", "8000"]
